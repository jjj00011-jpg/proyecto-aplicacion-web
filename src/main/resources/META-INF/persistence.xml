<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="reservaPU" transaction-type="JTA">
        <jta-data-source>java:global/jdbc/reservauja</jta-data-source>

        <class>daw.app.model.Alojamiento</class>
        <class>daw.app.model.Usuario</class>
        <class>daw.app.model.Servicio</class>
        <class>daw.app.model.AlojamientoServicio</class>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action"
                      value="drop-and-create"/>

            <property name="eclipselink.logging.level" value="INFO"/>
            <property name="eclipselink.logging.parameters" value="true"/>
            <property name="eclipselink.logging.level.sql" value="FINE"/>
        </properties>
    </persistence-unit>

</persistence>